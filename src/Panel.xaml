            <GeometryDrawing Brush="#26241D" Geometry="M 35,40 Q 47,20 62,36 Q 54,54 40,47 Z"/>
            <GeometryDrawing Brush="#E8DDAD" Geometry="M 40,39 Q 49,28 57,37 Q 49,47 40,39 Z"/>
            <GeometryDrawing Brush="#26241D" Geometry="M 46,37 L 50,34 53,38 49,42 46,40 Z"/>
        </DrawingGroup></DrawingImage.Drawing>
    </DrawingImage>
    <DrawingImage x:Key="Attachment">
        <DrawingImage.Drawing><DrawingGroup>
            <GeometryDrawing Brush="#B27FBE" Geometry="{StaticResource Profile}"/>
            <GeometryDrawing Brush="#261C2A" Geometry="M 32,16 L 67,10 76,16 64,24 49,34 44,25 31,24 Z M 29,29 L 39,29 45,38 36,36 21,44 Z M 45,44 L 55,41 46,54 31,61 30,54 Z M 62,46 L 74,36 70,54 65,60 60,57 Z M 43,63 L 58,68 68,62 65,80 41,80 Z"/>
            <GeometryDrawing Brush="#E5B7E7" Geometry="M 25,47 L 37,40 44,40 47,43 43,46 39,44 34,47 37,49 29,54 Z M 77,20 L 72,32 62,42 55,46 51,42 54,38 58,40 62,35 59,34 66,29 Z"/>
            <GeometryDrawing Brush="#281D2B" Geometry="M 38,47 L 42,46 44,48 40,50 Z M 54,39 L 57,35 60,35 58,38 Z"/>
        </DrawingGroup></DrawingImage.Drawing>
    </DrawingImage>
    <DrawingImage x:Key="Repression">
        <DrawingImage.Drawing><DrawingGroup>
            <GeometryDrawing Brush="#4EC3B5" Geometry="{StaticResource Profile}"/>
            <GeometryDrawing Brush="#152522" Geometry="M 29,16 L 47,13 43,26 38,22 40,32 29,26 33,25 Z M 50,13 L 62,11 57,19 61,19 51,31 49,22 52,22 Z M 69,11 L 78,16 72,31 70,26 61,31 65,20 67,22 Z M 25,34 L 40,37 35,41 41,44 28,47 30,43 19,44 Z M 63,39 L 75,34 71,47 68,44 62,46 Z M 29,53 L 41,48 40,59 37,55 30,61 Z M 44,79 L 47,65 43,67 52,52 56,66 52,64 52,80 Z M 60,55 L 67,52 63,80 57,80 Z"/>
            <GeometryDrawing Brush="#9DE2D4" Geometry="M 46,34 L 62,32 59,48 44,50 Z"/>
        </DrawingGroup></DrawingImage.Drawing>
    </DrawingImage>
    <Style x:Key="OrderTile" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Height" Value="121"/>
        <Setter Property="Template">
            <Setter.Value><ControlTemplate TargetType="Button">
                <Grid>
                    <Border x:Name="Tile" Background="{TemplateBinding Background}" BorderBrush="#524548" BorderThickness="1"/>
                    <Border x:Name="Light" Background="{TemplateBinding Foreground}" Opacity="0"/>
                    <Path HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5" Data="M 0,8 L 0,0 9,0"/>
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Tile" Property="BorderBrush" Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"/>
                        <Setter TargetName="Light" Property="Opacity" Value="0.07"/>
                    </Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True">
                        <Setter TargetName="Tile" Property="BorderBrush" Value="White"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Light" Property="Opacity" Value="0.17"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Button">
        <Setter Property="Foreground" Value="#DBE7ED"/>
        <Setter Property="Background" Value="#192630"/>
        <Setter Property="BorderBrush" Value="#35424E"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="11,7"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="BorderBrush" Value="#80D8DF"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Surface" Property="BorderBrush" Value="#B7F1F2"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Surface" Property="Opacity" Value="0.7"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
