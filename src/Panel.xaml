        <DrawingImage.Drawing><DrawingGroup>
            <GeometryDrawing Brush="#E95460" Geometry="M 40,14 L 74,7 85,15 80,42 73,61 69,84 39,84 43,63 31,61 15,67 10,62 25,50 17,51 14,47 11,52 7,50 3,33 36,28 Z"/>
            <GeometryDrawing Brush="#23151A" Geometry="M 44,17 L 73,11 80,17 74,40 68,47 75,46 66,80 45,80 50,58 38,53 46,45 40,39 Z M 14,41 L 31,39 28,44 24,43 21,48 18,44 16,48 Z"/>
            <GeometryDrawing Brush="#E95460" Geometry="M 59,23 L 68,17 65,25 68,24 57,35 Z M 53,34 L 47,27 46,34 49,40 44,44 54,42 Z M 57,43 L 69,36 65,45 68,45 56,55 Z M 53,49 L 60,59 55,58 51,71 49,58 46,60 Z"/>
        </DrawingGroup></DrawingImage.Drawing>
    </DrawingImage>
    <DrawingImage x:Key="Insight">
        <DrawingImage.Drawing><DrawingGroup>
            <GeometryDrawing Brush="#E8DDAD" Geometry="{StaticResource Profile}"/>
